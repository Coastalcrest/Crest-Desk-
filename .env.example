# CrestDesk Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files — they contain secrets

# ─── Domain ───────────────────────────────────────────
APP_DOMAIN=coastalcrest.net
APP_URL=https://app.coastalcrest.net
SIGN_URL=https://sign.coastalcrest.net
PORTAL_URL=https://portal.coastalcrest.net
API_URL=https://api.coastalcrest.net

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://crestdesk:crestdesk_dev@localhost:5432/crestdesk
DATABASE_POOL_SIZE=20

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────
# REQUIRED: JWT_SECRET must be set and at least 32 characters long.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The gateway will refuse to start without this value.
JWT_SECRET=CHANGE_ME_generate_a_random_64_char_hex_string
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
MFA_ISSUER=CrestDesk

# ─── Email ────────────────────────────────────────────
EMAIL_PROVIDER=postmark
POSTMARK_API_TOKEN=your-postmark-api-token-here
EMAIL_FROM=no-reply@coastalcrest.net

# ─── AWS ──────────────────────────────────────────────
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
S3_BUCKET_DOCUMENTS=crestdesk-documents-dev
S3_BUCKET_MEDIA=crestdesk-media-dev

# ─── Monitoring ───────────────────────────────────────
DATADOG_API_KEY=your-datadog-api-key-here
DATADOG_APP_KEY=your-datadog-app-key-here
DD_ENV=development
DD_SERVICE=crestdesk
DD_VERSION=0.0.1

# ─── AI Services (Phase 7+) ──────────────────────────
AI_IMAGE_PROVIDER=replicate
AI_IMAGE_API_KEY=your-replicate-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Feature Flags ───────────────────────────────────
FEATURE_FLAGS_ENABLED=true

# ─── Multi-Tenancy ───────────────────────────────────
TENANT_MODE=multi

# ─── Node ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
GATEWAY_PORT=4000
LOG_LEVEL=debug
