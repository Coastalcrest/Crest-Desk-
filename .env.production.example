# CrestDesk Production Environment Variables
# Copy to .env and fill in real values. NEVER commit .env files.

# ─── Domain ───────────────────────────────────────────
APP_DOMAIN=crestdesk.com
CORS_ORIGIN=https://app.crestdesk.com

# ─── Database ─────────────────────────────────────────
POSTGRES_USER=crestdesk
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_16
POSTGRES_DB=crestdesk
DATABASE_URL=postgresql://crestdesk:CHANGE_ME@postgres:5432/crestdesk

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Auth ─────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64

# ─── Node ─────────────────────────────────────────────
NODE_ENV=production
GATEWAY_PORT=4000
LOG_LEVEL=info

# ─── Monitoring (optional) ────────────────────────────
DD_TRACE_ENABLED=false
